    {
      "name": "Renal impairment dose adjustment",
      "labelStatus": "on-label",
      "dosageRegimens": [
        {
          "population": "renal-impairment",
          "route": "oral",
          "dose": {
            "basis": "flat",
            "amount": {
              "value": 20,
              "unit": "mg"
            }
          },
          "dosingInterval": {
            "minMinutes": 1440,
            "maxMinutes": 2880
          },
          "asNeeded": false,
          "notes": "CrCl below 50 mL/min: halve the dose or double the interval. Because clearance is renal rather than hepatic, this is where famotidine needs attention — unlike cimetidine, whose problems are hepatic."
        }
      ]
    }
