  "indications": [
    {
      "name": "Flatulence / functional gastric bloating",
      "labelStatus": "on-label",
      "dosageRegimens": [
        {
          "population": "adult",
          "route": "oral",
          "dose": {
            "basis": "flat",
            "amount": {
              "steps": [
                40,
                80,
                125,
                180
              ],
              "unit": "mg"
            }
          },
          "asNeeded": true,
          "maxDailyDose": {
            "value": 500,
            "unit": "mg"
          },
          "notes": "After meals and at bedtime. Chewable tablets must be chewed thoroughly — the mechanism is physical contact with gas bubbles."
        }
      ]
    }
  ],
  "mechanismsOfAction": [
    {
      "termId": "surface-tension-reduction",
      "evidence": "established",
      "note": "Lowers the surface tension of gas bubbles so they coalesce and pass. Entirely physical; no receptor, no enzyme, no absorption."
    }
  ],
  "metabolismPathways": [
    {
      "termId": "not-absorbed",
      "fractionOfDose": {
        "value": 1.0
      },
      "note": "Excreted unchanged in faeces."
    }
  ],
